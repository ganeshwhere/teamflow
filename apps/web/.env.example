# NextAuth session signing secret (web-only).
NEXTAUTH_SECRET="your-secret-min-32-chars"

# Public URL of the Next.js app.
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (required for login).
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxx"
GITHUB_CLIENT_ID="xxxx"
GITHUB_CLIENT_SECRET="xxxx"

# Base URL for NestJS API.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Shared server-to-server secret for auth bridge calls to API.
AUTH_BRIDGE_SECRET="your-auth-bridge-secret-min-32-chars"
