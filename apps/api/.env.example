# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://postgres:pass@localhost:5432/projectdb?schema=public"

# API access token signing config (API-owned).
API_JWT_SECRET="your-api-jwt-secret-min-32-chars"
API_JWT_EXPIRY="15m"
API_JWT_ISSUER="teamflow-api"
API_JWT_AUDIENCE="teamflow-clients"

# Shared server-to-server secret for web -> API auth bridge endpoints.
AUTH_BRIDGE_SECRET="your-auth-bridge-secret-min-32-chars"

# Dedicated invite-token signing secret.
# If omitted, API_JWT_SECRET is used.
TEAM_INVITE_JWT_SECRET="your-team-invite-secret-min-32-chars"

# Resend email configuration (optional in local dev, required for real invites/assignment emails).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Public app URL used in invite/task links inside emails.
APP_URL="http://localhost:3000"

# Rate limiting (milliseconds for *_TTL_MS).
RATE_LIMIT_DEFAULT_LIMIT="120"
RATE_LIMIT_DEFAULT_TTL_MS="60000"
RATE_LIMIT_AUTH_VERIFY_LIMIT="20"
RATE_LIMIT_AUTH_VERIFY_TTL_MS="60000"
RATE_LIMIT_TEAM_INVITE_LIMIT="6"
RATE_LIMIT_TEAM_INVITE_TTL_MS="600000"
RATE_LIMIT_TEAM_JOIN_LIMIT="20"
RATE_LIMIT_TEAM_JOIN_TTL_MS="600000"
RATE_LIMIT_TASK_WRITE_LIMIT="90"
RATE_LIMIT_TASK_WRITE_TTL_MS="60000"
RATE_LIMIT_CHAT_WRITE_LIMIT="120"
RATE_LIMIT_CHAT_WRITE_TTL_MS="60000"

# NestJS API port.
PORT="4000"
