# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://postgres:pass@localhost:5432/projectdb?schema=public"

# Must match apps/web NEXTAUTH_SECRET.
NEXTAUTH_SECRET="your-secret-min-32-chars"

# API token expiry used when web signs API JWTs.
JWT_EXPIRY="7d"

# Resend email configuration (optional in local dev, required for real invites/assignment emails).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Public app URL used in invite/task links inside emails.
APP_URL="http://localhost:3000"

# NestJS API port.
PORT="4000"
